    "name": "BookStore",
    "slug": "bookstore",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.bookstore"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
